{
  "manifest_version": 3,
  "name": "한장캡처 - 전체 페이지 스크롤 캡처와 편집",
  "short_name": "한장캡처",
  "version": "1.4.0",
  "description": "웹 페이지 전체를 스크롤하며 한 장으로 찍고, 표시·가리기·자르기를 한 뒤 PNG, JPG, PDF로 저장합니다. 계정과 인터넷 전송 없이 이 기기에만 보관합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "한장캡처: 이 페이지 전체 찍기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "commands": {
    "_execute_action": {
      "description": "도구 창 열기"
    },
    "capture-full": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "페이지 전체 찍기"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "페이지 일부 찍기"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' data: blob:"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
